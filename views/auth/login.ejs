<div class="row justify-content-center">
  <div class="col-md-5">
    <h1 class="h3 mb-4">Iniciar sesión</h1>
    <form method="POST" action="/auth/login" novalidate>
      <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <input class="form-control" type="email" id="email" name="email" autocomplete="email" required value="<%= locals.old ? (old.email || '') : '' %>">
      </div>
      <div class="mb-3">
        <label class="form-label" for="password">Contraseña</label>
        <input class="form-control" type="password" id="password" name="password" autocomplete="current-password" required>
      </div>
      <button class="btn btn-primary w-100" type="submit">Entrar</button>
    </form>
    <p class="mt-3 text-center">¿No tienes cuenta? <a href="/auth/register">Regístrate</a></p>
  </div>
</div>
