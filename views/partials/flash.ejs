<% const tipos = ['success', 'info', 'warning', 'danger']; %>
<% (locals.flash || []).forEach(function (m) {
     const t = m.type === 'error' ? 'danger' : (tipos.includes(m.type) ? m.type : 'info'); %>
  <div class="alert alert-<%= t %> alert-dismissible fade show" role="alert">
    <%= m.message %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
  </div>
<% }); %>
<% if (locals.errors && locals.errors.length) { %>
  <div class="alert alert-danger" role="alert">
    <strong>Revisa el formulario:</strong>
    <ul class="mb-0">
      <% errors.forEach(function (e) { %><li><%= e %></li><% }); %>
    </ul>
  </div>
<% } %>
