# Copia este archivo a .env y completa los valores. NUNCA subas .env a Git.
NODE_ENV=development
PORT=3000

# Cadena de conexión de MongoDB Atlas (o mongodb://localhost:27017/recetario en local)
DATABASE_URL=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/recetario?retryWrites=true&w=majority

# Secreto para firmar JWT (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Opcional: secreto distinto para refresh tokens (si no, se deriva de JWT_SECRET)
# JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_DAYS=7

# Opcional
# BCRYPT_ROUNDS=12
# CORS_ORIGIN=https://otro-dominio.com
# COOKIE_SECURE=false      # solo para probar NODE_ENV=production en http://localhost
# UPLOAD_DIR=/data/uploads # ruta de un disco persistente (Render Disk)

# Script de admin (npm run seed:admin)
# ADMIN_NAME=Administrador
# ADMIN_EMAIL=admin@correo.com
# ADMIN_PASSWORD=UnaClaveSegura123
